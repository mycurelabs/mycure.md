# Google Analytics
# Get your Measurement ID from: https://analytics.google.com/
# Admin → Data Streams → Web → Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Hapihub public API base URL — powers the public booking profile pages
# (/d/[slug] doctors, /c/[slug] clinics). Routes are served at ROOT (no /api
# prefix). Defaults to production if unset.
#   Production: https://hapihub.localfirsthealth.com
#   Staging:    https://hapihub.stg.localfirsthealth.com
#   Local:      http://localhost:7500
NEXT_PUBLIC_HAPIHUB_URL=https://hapihub.localfirsthealth.com
